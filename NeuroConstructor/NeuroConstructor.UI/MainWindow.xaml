<Window x:Class="NeuroConstructor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuroConstructor" Height="750" Width="1200"
        FontFamily="Segoe UI" Background="#1e1e2e" Foreground="#e0dff4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8a89a8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3a3a60"/>
                                <Setter Property="Foreground" Value="#e0dff4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#7c6ff7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="BorderBrush" Value="#3e3e5a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7c6ff7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9d92f5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Background="#12122a" BorderBrush="#3e3e5a" BorderThickness="0,0,1,0">
            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="SidebarChatButton" Style="{StaticResource SidebarButtonStyle}" Tag="Chat" Click="Sidebar_Click">
                    <TextBlock Text="💬" FontSize="18"/>
                </Button>
                <Button x:Name="SidebarModelButton" Style="{StaticResource SidebarButtonStyle}" Tag="Model" Click="Sidebar_Click">
                    <TextBlock Text="🤖" FontSize="18"/>
                </Button>
                <Button x:Name="SidebarDatasetButton" Style="{StaticResource SidebarButtonStyle}" Tag="Dataset" Click="Sidebar_Click">
                    <TextBlock Text="📁" FontSize="18"/>
                </Button>
                <Rectangle Height="1" Fill="#3e3e5a" Margin="0,8,0,8"/>
                <Button x:Name="SidebarSettingsButton" Style="{StaticResource SidebarButtonStyle}" Tag="Settings" Click="Sidebar_Click">
                    <TextBlock Text="⚙️" FontSize="18"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== MAIN AREA ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat Content -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat History -->
                <ListBox x:Name="ChatHistoryBox" Grid.Row="0" Background="#0d0d20" BorderBrush="#3e3e5a"
                         Foreground="#e0dff4" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13">
                                <Run FontWeight="Bold" Foreground="#9d92f5" Text="{Binding Sender}"/>
                                <Run Foreground="#8a89a8" Text="{Binding Timestamp, StringFormat=' hh:mm'}"/>
                                <Run Text=": "/>
                                <Run Foreground="{Binding TextColor}" Text="{Binding Text}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input Area -->
                <Border Grid.Row="1" Background="#252540" BorderBrush="#3e3e5a" BorderThickness="0,1,0,0" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MessageInput" Background="#0d0d20" BorderBrush="#3e3e5a" Foreground="#e0dff4"
                                 FontSize="13" Padding="14,10" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Отправить" Style="{StaticResource PrimaryButtonStyle}"
                                Height="36" Width="100" Click="SendButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
