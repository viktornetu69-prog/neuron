<Window x:Class="NeuroConstructor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuroConstructor" Height="800" Width="1400"
        FontFamily="Segoe UI" Background="#0a0a0f" Foreground="#e8e8e8"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ===== SIDEBAR STYLES ===== -->
        <Style x:Key="SidebarNavStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8888aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#16162a"/>
                                <Setter Property="Foreground" Value="#d0d0e8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarNavStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavStyle}">
            <Setter Property="Background" Value="#1e1e35"/>
            <Setter Property="Foreground" Value="#9d8fff"/>
        </Style>

        <!-- ===== CARD STYLES ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121220"/>
            <Setter Property="BorderBrush" Value="#1e1e30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#16162a"/>
            <Setter Property="BorderBrush" Value="#2a2a40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7c6ff7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16162a"/>
            <Setter Property="Foreground" Value="#b8b8d0"/>
            <Setter Property="BorderBrush" Value="#2a2a40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Copy Button Style -->
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666688"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a1a2e"/>
                                <Setter Property="Foreground" Value="#9d8fff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2a2a40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ContextMenu -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#121220"/>
            <Setter Property="BorderBrush" Value="#1e1e30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme MenuItem -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a1a2e"/>
                                <Setter Property="Foreground" Value="#9d8fff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menus -->
        <ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Header="ЁЯУЛ  ╨Ъ╨╛╨┐╨╕╤А╨╛╨▓╨░╤В╤М ╤Б╨╛╨╛╨▒╤Й╨╡╨╜╨╕╨╡" Click="CopyMessage_Click" Tag="{Binding Text}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarWidth" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#0d0d18" BorderBrush="#1a1a2a" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & New Chat -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel>
                        <TextBlock Text="тЪб NeuroConstructor" Foreground="#9d8fff" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <Button Content="я╝Л  ╨Э╨╛╨▓╤Л╨╣ ╤З╨░╤В" Height="38" Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewChat_Click"/>

                        <Separator Margin="0,16,0,12" Background="#1a1a2a"/>

                        <!-- Navigation -->
                        <Button x:Name="NavChatButton" Style="{StaticResource ActiveSidebarNavStyle}"
                                Tag="Chat" Click="NavButton_Click" Margin="0,0,0,4"
                                Content="ЁЯТм  ╨з╨░╤В"/>
                        <Button x:Name="NavModelButton" Style="{StaticResource SidebarNavStyle}"
                                Tag="Model" Click="NavButton_Click" Margin="0,0,0,4"
                                Content="ЁЯдЦ  ╨Ь╨╛╨┤╨╡╨╗╤М"/>
                        <Button x:Name="NavDatasetButton" Style="{StaticResource SidebarNavStyle}"
                                Tag="Dataset" Click="NavButton_Click" Margin="0,0,0,4"
                                Content="ЁЯУБ  ╨Ф╨░╤В╨░╤Б╨╡╤В╤Л"/>
                        <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarNavStyle}"
                                Tag="Settings" Click="NavButton_Click" Margin="0,0,0,12"
                                Content="тЪЩя╕П  ╨Э╨░╤Б╤В╤А╨╛╨╣╨║╨╕"/>
                    </StackPanel>
                </Border>

                <!-- Model Status -->
                <StackPanel Grid.Row="1" Margin="16,0,16,0">
                    <Separator Background="#1a1a2a" Margin="0,0,0,12"/>
                    <Border Background="#121220" BorderBrush="#1e1e30" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Qwen3-4B-Thinking" Foreground="#9d8fff" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Q4_K_M ┬╖ 4.2 GB" Foreground="#666688" FontSize="11" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="6" Height="6" Fill="#4ec9b0" Margin="0,0,6,0"/>
                                <TextBlock Text="╨Р╨║╤В╨╕╨▓╨╜╨░" Foreground="#4ec9b0" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Connection Status -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="#1a1a2a" BorderThickness="0,1,0,0" Background="#0a0a12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#4ec9b0" Margin="0,0,8,0"/>
                        <TextBlock Text="localhost:50051" Foreground="#666688" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" Background="#0a0a0f">

            <!-- ===== CHAT VIEW ===== -->
            <Grid x:Name="ChatView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat History -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32,24">
                    <ListBox x:Name="ChatHistoryBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BubbleColor}" BorderBrush="{Binding BubbleBorderColor}"
                                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,40,12"
                                        HorizontalAlignment="{Binding Alignment}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding SenderName}" Foreground="{Binding SenderColor}"
                                                       FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                            <Button DockPanel.Dock="Right" Content="ЁЯУЛ" Style="{StaticResource CopyButtonStyle}"
                                                    Margin="0,0,8,0" Click="CopyButton_Click"
                                                    Tag="{Binding Text}" ToolTip="╨Ъ╨╛╨┐╨╕╤А╨╛╨▓╨░╤В╤М ╤Б╨╛╨╛╨▒╤Й╨╡╨╜╨╕╨╡"/>
                                        </DockPanel>
                                        <TextBox x:Name="MessageTextBlock" Text="{Binding Text}" Foreground="#e0e0e0"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Background="Transparent" BorderThickness="0"
                                                   IsReadOnly="True" Padding="0"
                                                   MouseRightButtonUp="MessageTextBlock_MouseRightButtonUp"
                                                   ContextMenu="{StaticResource CopyContextMenu}"
                                                   Focusable="True"/>
                                        <DockPanel HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Timestamp}" Foreground="#666688"
                                                       FontSize="10"/>
                                            <Button DockPanel.Dock="Right" Content="ЁЯУЛ" Style="{StaticResource CopyButtonStyle}"
                                                    Margin="6,0,0,0" Click="CopyButton_Click"
                                                    Tag="{Binding Text}" ToolTip="╨Ъ╨╛╨┐╨╕╤А╨╛╨▓╨░╤В╤М"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Input Area -->
                <Border Grid.Row="1" Background="#0d0d18" BorderBrush="#1a1a2a" BorderThickness="0,1,0,0" Padding="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageInput" Grid.Column="0"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,12,0"/>

                        <Button Grid.Column="1" Content="╨Ю╤В╨┐╤А╨░╨▓╨╕╤В╤М" Style="{StaticResource PrimaryButtonStyle}"
                                Height="46" Width="120" Click="SendButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== MODEL VIEW ===== -->
            <ScrollViewer x:Name="ModelView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel>
                    <TextBlock Text="ЁЯдЦ  ╨г╨┐╤А╨░╨▓╨╗╨╡╨╜╨╕╨╡ ╨╝╨╛╨┤╨╡╨╗╤П╨╝╨╕" Foreground="#9d8fff" FontWeight="Bold" FontSize="24" Margin="0,0,0,32"/>

                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ЁЯза  ╨г╤З╨╕╤В╨╡╨╗╤М (Teacher)" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>
                                <TextBlock><Run Foreground="#8888aa">╨Ь╨╛╨┤╨╡╨╗╤М:</Run> <Run Foreground="#e0e0e0">Qwen3-4B-Thinking</Run></TextBlock>
                                <TextBlock Margin="0,4,0,0"><Run Foreground="#8888aa">╨а╨░╨╖╨╝╨╡╤А:</Run> <Run Foreground="#e0e0e0">4.2 GB</Run></TextBlock>
                                <TextBlock Margin="0,4,0,0"><Run Foreground="#8888aa">╨Я╨░╤А╨░╨╝╨╡╤В╤А╤Л:</Run> <Run Foreground="#e0e0e0">4B</Run></TextBlock>
                                <TextBlock Text="тЬУ  ╨Ч╨░╨│╤А╤Г╨╢╨╡╨╜╨░" Foreground="#4ec9b0" FontWeight="Bold" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ЁЯОУ  ╨б╤В╤Г╨┤╨╡╨╜╤В (Student)" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>
                                <TextBlock><Run Foreground="#8888aa">╨Ь╨╛╨┤╨╡╨╗╤М:</Run> <Run Foreground="#666688">тАФ</Run></TextBlock>
                                <TextBlock Margin="0,4,0,0"><Run Foreground="#8888aa">╨а╨░╨╖╨╝╨╡╤А:</Run> <Run Foreground="#666688">тАФ</Run></TextBlock>
                                <TextBlock Text="тП│  ╨Э╨╡ ╤Б╨╛╨╖╨┤╨░╨╜╨░" Foreground="#dcdcaa" FontWeight="Bold" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="тЪЩя╕П  ╨Ю╨┐╨╡╤А╨░╤Ж╨╕╨╕" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
                    <WrapPanel>
                        <Button x:Name="LoadTeacherButton" Content="ЁЯУВ  ╨Ч╨░╨│╤А╤Г╨╖╨╕╤В╤М ╤Г╤З╨╕╤В╨╡╨╗╤П" Height="48" Width="200" Margin="0,0,12,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="CreateStudentButton" Content="ЁЯФД  ╨б╨╛╨╖╨┤╨░╤В╤М ╤Б╤В╤Г╨┤╨╡╨╜╤В╨░" Height="48" Width="200" Margin="0,0,12,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="ConvertModelButton" Content="тЪб  ╨Ъ╨╛╨╜╨▓╨╡╤А╤В╨╕╤А╨╛╨▓╨░╤В╤М" Height="48" Width="200" Margin="0,0,12,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="ValidateModelButton" Content="тЬУ  ╨Я╤А╨╛╨▓╨╡╤А╨╕╤В╤М ╨║╨░╤З╨╡╤Б╤В╨▓╨╛" Height="48" Width="200" Margin="0,0,12,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>

                    <TextBlock Text="ЁЯУИ  ╨Я╤А╨╛╨│╤А╨╡╤Б╤Б" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,32,0,20"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="╨Ъ╨╛╨╜╨▓╨╡╤А╤В╨░╤Ж╨╕╤П ╨╝╨╛╨┤╨╡╨╗╨╕..." Foreground="#e0e0e0" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="67%" Foreground="#9d8fff" HorizontalAlignment="Right" FontSize="14"/>
                            </Grid>
                            <ProgressBar Value="67" Height="6" Margin="0,12,0,0" Background="#16162a" Foreground="#7c6ff7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== DATASET VIEW ===== -->
            <ScrollViewer x:Name="DatasetView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel>
                    <TextBlock Text="ЁЯУБ  ╨г╨┐╤А╨░╨▓╨╗╨╡╨╜╨╕╨╡ ╨┤╨░╤В╨░╤Б╨╡╤В╨░╨╝╨╕" Foreground="#9d8fff" FontWeight="Bold" FontSize="24" Margin="0,0,0,32"/>
                    <TextBlock Text="ЁЯУК  game_ai тАФ 145 ╨┐╤А╨╕╨╝╨╡╤А╨╛╨▓" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid x:Name="DatasetDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderBrush="#1e1e30" Foreground="#e0e0e0"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="13"
                                  Margin="-20"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== SETTINGS VIEW ===== -->
            <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel>
                    <TextBlock Text="тЪЩя╕П  ╨Э╨░╤Б╤В╤А╨╛╨╣╨║╨╕" Foreground="#9d8fff" FontWeight="Bold" FontSize="24" Margin="0,0,0,32"/>

                    <!-- ╨Т╨Э╨Х╨и╨Э╨Ш╨Щ ╨Т╨Ш╨Ф -->
                    <TextBlock Text="ЁЯОи  ╨Т╨╜╨╡╤И╨╜╨╕╨╣ ╨▓╨╕╨┤" Foreground="#9d8fff" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>

                    <!-- Theme Radio Buttons -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="╨в╨╡╨╝╨░ ╨╛╤Д╨╛╤А╨╝╨╗╨╡╨╜╨╕╤П" Foreground="#e0e0e0" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="ЁЯЦея╕П Windows" GroupName="Theme" Checked="WindowsTheme_Click" Margin="0,0,16,0" Foreground="#e0e0e0"/>
                            <RadioButton Content="ЁЯМС ╨в╨╡╨╝╨╜╨░╤П" GroupName="Theme" Checked="DarkTheme_Click" Margin="0,0,16,0" Foreground="#e0e0e0" IsChecked="True"/>
                            <RadioButton Content="тШАя╕П ╨б╨▓╨╡╤В╨╗╨░╤П" GroupName="Theme" Checked="LightTheme_Click" Margin="0,0,16,0" Foreground="#e0e0e0"/>
                            <RadioButton Content="ЁЯОи ╨б╨▓╨╛╤П" GroupName="Theme" Checked="CustomTheme_Click" Foreground="#e0e0e0"/>
                        </StackPanel>

                        <!-- Custom Theme Block -->
                        <Border x:Name="CustomThemeBlock" Background="#121220" BorderBrush="#1e1e30"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="╨Я╨╛╨╗╤М╨╖╨╛╨▓╨░╤В╨╡╨╗╤М╤Б╨║╨╕╨╡ ╤Ж╨▓╨╡╤В╨░" Foreground="#9d8fff" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="╨д╨╛╨╜:" Foreground="#8888aa" Width="100" VerticalAlignment="Center"/>
                                    <TextBox x:Name="BackgroundPicker" Text="#0a0a0f" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#0a0a0f" CornerRadius="4" x:Name="BackgroundPreview"/>
                                    <TextBlock Text="╨б╨░╨╣╨┤╨▒╨░╤А:" Foreground="#8888aa" Width="100" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="SidebarPicker" Text="#0d0d18" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#0d0d18" CornerRadius="4" x:Name="SidebarPreview"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="╨Ъ╨░╤А╤В╨╛╤З╨║╨╕:" Foreground="#8888aa" Width="100" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CardPicker" Text="#121220" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#121220" CornerRadius="4" x:Name="CardPreview"/>
                                    <TextBlock Text="╨в╨╡╨║╤Б╤В:" Foreground="#8888aa" Width="100" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="TextPicker" Text="#e0e0e0" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#e0e0e0" CornerRadius="4" x:Name="TextPreview"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="╨Р╨║╤Ж╨╡╨╜╤В:" Foreground="#8888aa" Width="100" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AccentPicker" Text="#7c6ff7" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#7c6ff7" CornerRadius="4" x:Name="AccentPreview"/>
                                    <TextBlock Text="╨Т╤Л╨┤╨╡╨╗╨╡╨╜╨╕╨╡:" Foreground="#8888aa" Width="100" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="HighlightPicker" Text="#1e1e35" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#1e1e35" CornerRadius="4" x:Name="HighlightPreview"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="╨Ь╨╡╨╜╤О:" Foreground="#8888aa" Width="100" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MenuPicker" Text="#121220" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#121220" CornerRadius="4" x:Name="MenuPreview"/>
                                    <TextBlock Text="╨в╨╡╨║╤Б╤В ╨╝╨╡╨╜╤О:" Foreground="#8888aa" Width="100" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="MenuTextPicker" Text="#e0e0e0" Width="80" Margin="4,0,16,0"
                                             Style="{StaticResource InputStyle}" Height="32" Padding="8,0"
                                             TextChanged="CustomColor_TextChanged"/>
                                    <Border Width="32" Height="32" Background="#e0e0e0" CornerRadius="4" x:Name="MenuTextPreview"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="╨б╨▒╤А╨╛╤Б" Width="90" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="ResetTheme_Click"/>
                                    <Button Content="╨б╨╛╤Е╤А╨░╨╜╨╕╤В╤М ╨╜╨░╤Б╤В╤А╨╛╨╣╨║╨╕" Height="36" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Click="SaveTheme_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
