<Window x:Class="NeuroConstructor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeuroConstructor"
        mc:Ignorable="d"
        Language="ru-RU"
        Title="NeuroConstructor: Русский Интерфейс" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- История чата -->
        <ScrollViewer Grid.Row="0" Margin="10">
            <ListBox x:Name="ChatHistory" 
                     FontFamily="Consolas" 
                     FontSize="14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VerticalAlignment="Stretch"
                     Background="#F5F5F5"
                     BorderBrush="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar/User indicator -->
                            <Border Grid.Column="0" Width="12" Height="12" 
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding IsUser, ConverterParameter=Orange, Converter={StaticResource ColorConverter}}"/>
                                </Border.Background>
                                <TextBlock Text="•" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Message content -->
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Message}" 
                                       Foreground="{Binding IsUser, ConverterParameter=Black, Converter={StaticResource ColorConverter}}"
                                       FontSize="14" MaxWidth="680">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="Gray"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Панель ввода -->
        <Grid Grid.Row="1" Margin="10" Background="White" Height="80" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Message Input -->
            <TextBox x:Name="UserInput" 
                     Grid.Column="0" 
                     Height="40" 
                     FontFamily="Consolas" 
                     FontSize="16"
                     PreviewKeyDown="UserInput_PreviewKeyDown"
                     Margin="0,0,10,0"
                     PlaceholderText="Введите сообщение..."/>

            <!-- Send Button -->
            <Button x:Name="SendButton" 
                    Grid.Column="1" 
                    Content="Отправить" 
                    Height="40" 
                    Width="80" 
                    FontSize="14"
                    Click="SendButton_Click"
                    Margin="0,0,10,0"
                    Background="#FF6B6B"
                    Foreground="White"
                    Cursor="Hand"/>

            <!-- Clear Button -->
            <Button x:Name="ClearButton" 
                    Grid.Column="2" 
                    Content="Очистить" 
                    Height="40" 
                    Width="80" 
                    FontSize="14"
                    Click="ClearButton_Click"
                    Background="#505050"
                    Foreground="White"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>